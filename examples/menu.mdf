# Example menu. Start it with:  ./automenu examples/menu.mdf
# The first menu in the file is always the start menu.

# Settings (all optional, without a line the default applies)
# set blackout 300      the screen goes black after 300 seconds without input
# set clock utc         clock in UTC instead of local time
# set mouse off         switch the mouse off
#
# Password protection: create a line with  automenu --hash admin  and paste it here:
# password admin pbkdf2-sha256:...
# Then, on the item:  item "Reboot" lock admin run sudo reboot

menu start "Automenu"
  item "Date and time"         run date
  item "Who am I"              run whoami; hostname
  item "Files in this folder"  run ls -l
  item "Tools"                 menu tools
  item "About this menu"       info Automenu\nA menu like in the old days.
  item "Quit"                  exit

menu tools "Tools"
  item "Disk space"            run df -h
  item "Running programs"      run ps aux | head -20
  item "Back"                  back
