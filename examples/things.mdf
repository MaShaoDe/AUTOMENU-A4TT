# Recreation of the "Automenu for the Things" mockup.
# The second quoted text is the help text in the grey bar.

menu sensors "Automenu for the Things"
  item "General Sensor Overview"   "Access detailed sensor data and configurations"   info No sensor connected yet.
  item "Temperature Readings"      "Show all temperature sensors"                     info No sensor connected yet.
  item "Humidity Levels"           "Show all humidity sensors"                        info No sensor connected yet.
  item "Motion Detectors & Presence"  "Show motion and presence detectors"            info No sensor connected yet.
  item "Analog Inputs & Voltage"   "Read analog inputs"                               info No sensor connected yet.
  item "Digital Inputs & GPIO"     "Read digital inputs and GPIO pins"                info No sensor connected yet.
  item "System Menu"               "Manage system outputs and maintenance"            menu system

menu system "Automenu for the Things"
  item "Network Settings"          "Show network interfaces"                          run ifconfig 2>/dev/null || ip addr
  item "System Logs"               "Show the last system messages"                    run dmesg | tail -20
  item "Diagnostics"               "Show uptime and load"                             run uptime
  item "Disk Space"                "Show free disk space"                             run df -h
  item "Back"                      "Back to the sensors"                              back
