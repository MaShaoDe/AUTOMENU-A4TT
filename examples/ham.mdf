# Example for the radio shack. Adapt as you like.

menu start "Radio Shack"
  item "UTC time"              run date -u
  item "Calendar"              run cal
  item "Check the network"     run ping -c 3 1.1.1.1
  item "Open the log book"     run ${EDITOR:-vi} ~/logbook.txt
  item "Quit"                  exit
